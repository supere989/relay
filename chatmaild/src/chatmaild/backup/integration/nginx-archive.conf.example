# Optional TLS server-block fragment. No admin or /new route changes.
# Configure limit_req_zone $binary_remote_addr zone=archive:1m rate=1r/s;
# separately at http scope. No authorization codes in access/error logs.
location ^~ /archive/ {
    access_log off;
    error_log /dev/null crit;
    client_max_body_size 4k;
    client_body_timeout 10s;
    limit_req zone=archive burst=8 nodelay;
    proxy_pass http://127.0.0.1:10090;
    # Recovery responses contain private keys: never buffer them onto disk.
    proxy_buffering off;
    proxy_max_temp_file_size 0;
    proxy_cache off;
    proxy_store off;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    # Overwrite, never append or pass through a caller-supplied identity.
    proxy_set_header X-Chatmail-Archive-Client $remote_addr;
    proxy_connect_timeout 5s;
    proxy_read_timeout 90s;
}
location = /archive {
    return 302 /archive/;
}
